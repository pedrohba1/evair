# ============================================================
# EVAIR - configuração do emissor NFS-e
# Copie para .env e preencha. NUNCA versione o .env nem os .pfx.
# ============================================================

# --- Ambiente ---
# 1 = produção, 2 = homologação (produção restrita)
NFS_E_AMBIENTE=2

# --- Certificado digital ICP-Brasil (e-CNPJ) A1 ---
# Caminho do arquivo .pfx/.p12 e a senha. A chave privada fica
# somente aqui, no backend — nunca no prompt nem nos checkpoints.
NFS_E_CERT_PFX=./certs/certificado.pfx
NFS_E_CERT_SENHA=

# --- Identificação do prestador (emissor) ---
# CNPJ da matriz/estabelecimento emissor (14 dígitos, só números)
NFS_E_CNPJ=00000000000191
# Inscrição municipal (se exigida pelo município conveniado)
NFS_E_INSCRICAO_MUNICIPAL=
# Código IBGE do município emissor (Uberlândia/MG = 3170206)
NFS_E_COD_MUNICIPIO=3205200

# --- Endpoints (Sefin Nacional) ---
# Homologação (produção restrita)
NFS_E_URL_HOMOLOGACAO=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# Produção
NFS_E_URL_PRODUCAO=https://sefin.nfse.gov.br/SefinNacional

# --- Identidade do aplicativo ---
NFS_E_VER_APLIC=EVAIR_0.1.0
