# ============================================================
# EVAIR - configuração do emissor NFS-e
# Copie para .env e preencha. NUNCA versione o .env nem os .pfx.
# ============================================================

# --- Ambiente ---
# 1 = produção, 2 = homologação (produção restrita)
NFS_E_AMBIENTE=2

# --- Certificado digital ICP-Brasil (e-CNPJ) A1 ---
# O LOGIN usa a janela NATIVA de seleção de certificado do navegador (mTLS):
# o usuário clica em "Entrar com certificado digital" e escolhe o certificado
# instalado no sistema operacional (e-CNPJ / e-CPF). Nenhum arquivo é enviado.
#
# A ASSINATURA da DPS exige a chave privada. No EVAIR ela NÃO fica no backend:
# o usuário seleciona o .pfx no navegador (na hora de emitir) e o front-end
# envia o arquivo (base64) + senha junto com a aprovação do rascunho. O backend
# usa a chave só em memória no instante da assinatura e descarta em seguida.
#
# As variáveis abaixo (NFS_E_CERT_PFX / NFS_E_CERT_SENHA) são usadas APENAS
# pelos scripts de linha de comando (emitir_nfse_teste.py, test_mtls_client.py,
# inspect_chain.py) para testes manuais. O servidor (API) NÃO as lê.
NFS_E_CERT_PFX=./certs/certificado.pfx
NFS_E_CERT_SENHA=

# --- Identificação do prestador (emissor) ---
# CNPJ da matriz/estabelecimento emissor (14 dígitos, só números)
NFS_E_CNPJ=39982868000170
# Inscrição municipal (se exigida pelo município conveniado)
NFS_E_INSCRICAO_MUNICIPAL=
# Código IBGE do município emissor (Uberlândia/MG = 3170206)
NFS_E_COD_MUNICIPIO=3170206

# --- Endpoints (Sefin Nacional) ---
# Homologação (produção restrita)
NFS_E_URL_HOMOLOGACAO=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# Produção
NFS_E_URL_PRODUCAO=https://sefin.nfse.gov.br/SefinNacional

# --- Identidade do aplicativo ---
NFS_E_VER_APLIC=EVAIR_0.1.0

# --- Modelo de linguagem do agente (LangGraph) ---
# OpenAI-compatible: cobre Ollama local, ollama-cloud, OpenAI, DeepSeek.
# Aponte para o modelo que você usa (ex.: deepseek-v4-pro via ollama-cloud,
# ou um modelo do Ollama local). Sem um endpoint válido, o /chat retorna 500
# no nó de interpretação (o restante do fluxo — montagem, assinatura, emissão
# — é determinístico e não depende do LLM).
EV_LLM_BASE_URL=http://localhost:11434/v1
EV_LLM_MODEL=qwen2.5
EV_LLM_API_KEY=ollama
EV_LLM_TEMPERATURE=0

